{
  "name": "light-control-ui",
  "version": "0.1.0",
  "description": "OLED menu for a 2-output WS2812B / H-bridge light controller: 128x64 screen, four corner buttons. Plain C++ core; also an ESPHome external component.",
  "keywords": ["oled", "ssd1306", "sh1106", "menu", "ui", "ws2812b", "esphome"],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": "lcui_ui.h",
  "dependencies": [
    { "name": "icons", "version": "https://github.com/simonmetcalfe/oled-lcd-icons.git" }
  ],
  "build": {
    "srcDir": "components/light_control_ui",
    "includeDir": "components/light_control_ui",
    "srcFilter": ["-<*>", "+<lcui_*.cpp>"]
  }
}
